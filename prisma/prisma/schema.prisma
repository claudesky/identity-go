generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model apps {
  id   String @id @db.Uuid
  name String
}

model audiences {
  name          String          @id
  scopes        scopes[]
  user_audience user_audience[]
}

model email_verification_requests {
  id                  String   @id @db.Uuid
  register_request_id String   @db.Uuid
  email               String
  token               String
  revoked             Boolean  @default(false)
  accepted            Boolean  @default(false)
  expires_at          DateTime @db.Timestamp(6)
  created_at          DateTime @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model register_requests {
  id         String   @id @db.Uuid
  password   String
  email      String
  created_at DateTime @db.Timestamp(6)
}

model scopes {
  id         String       @id @db.Uuid
  audience   String
  name       String
  audiences  audiences    @relation(fields: [audience], references: [name], onDelete: Cascade, onUpdate: NoAction)
  user_scope user_scope[]

  @@unique([audience, name])
}

model token_families {
  id             String   @id @db.Uuid
  sub            String   @db.Uuid
  last_issued    String   @db.Uuid
  created_at     DateTime @db.Timestamp(6)
  last_issued_at DateTime @db.Timestamp(6)
  expires_at     DateTime @db.Timestamp(6)
  revoked        Boolean  @default(false)
}

model user_audience {
  user_id   String    @db.Uuid
  audience  String
  audiences audiences @relation(fields: [audience], references: [name], onDelete: Cascade, onUpdate: NoAction)
  users     users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, audience])
}

model user_scope {
  user_id  String @db.Uuid
  scope_id String @db.Uuid
  scopes   scopes @relation(fields: [scope_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users    users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, scope_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                       String          @id @db.Uuid
  password                 String?
  name                     String?
  email                    String?
  email_verified_on        DateTime?       @db.Timestamp(6)
  phone_number             String?
  phone_number_verified_on DateTime?       @db.Timestamp(6)
  user_audience            user_audience[]
  user_scope               user_scope[]
}
